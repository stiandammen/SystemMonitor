{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SystemMonitor",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/__main__.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "env": {
                "QT_AUTO_SCREEN_SCALE_FACTOR": "1"
            },
            "cwd": "${workspaceFolder}"
        }
    ]
}