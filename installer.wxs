<?xml version="1.0" encoding="UTF-8"?>
<!--
  System Monitor - WiX v3 installer definition.

  Installs per-user (no admin rights required). Default location is
  %LocalAppData%\Programs\System Monitor, matching the location already
  used by src/systemmonitor/utils/setup_installer.py - but the wizard
  below (WixUI_InstallDir) lets the user change the install folder.

  NOTE: this used to use WixUI_Mondo (directory chooser + optional feature
  tree for toggling each shortcut). After repeated reports that neither the
  directory chooser nor the shortcut toggles were appearing for the
  installed MSI, this was simplified to WixUI_InstallDir - a much simpler,
  far more commonly used dialog set that does ONLY one job (let the user
  pick the install directory) with none of Mondo's extra feature-tree /
  maintenance-mode branching, to remove variables and make the directory
  choice - the most repeatedly requested piece - as likely as possible to
  actually work. Both shortcuts (Start Menu + Desktop) are always created;
  they are no longer individually toggleable during install.

  ONEDIR CHANGE: SystemMonitor.spec now builds in "onedir" mode instead
  of "onefile" mode (see that file for the full write-up - in short, the
  onefile mode's self-extraction pattern was matching AppLocker/Windows Defender
  Application Control's default "block unsigned exe in a user-writable
  folder" behavior, causing the installed app to silently refuse to start
  with zero error output on managed/professional Windows machines). This
  MSI now installs a whole folder of files instead of one exe:
    - SystemMonitor.exe itself is still hand-authored below (Component
      Id="MainExecutable", File Id="SystemMonitorEXE") so the shortcuts
      and the "Launch System Monitor" finish-page action keep a stable,
      known File Id to target.
    - Everything else in dist\SystemMonitor\ (the _internal\ folder with
      Qt6 DLLs, etc.) is auto-harvested at build time by WiX's heat.exe
      into HarvestedFiles.wxs (see .github/workflows/release.yml), which
      defines the "HarvestedFiles" ComponentGroup referenced below.
    - Full recursive cleanup on uninstall (including nested subfolders
      heat.exe creates, which don't each get their own RemoveFolder
      entry) is handled by util:RemoveFolderEx instead of per-directory
      RemoveFolder bookkeeping - see the MainExecutable component.
    - light.exe is invoked with -sice:ICE38 -sice:ICE64 because those two
      validations expect every per-user component to carry its own HKCU
      registry keypath/RemoveFolder entry; that's done correctly here for
      the 3 hand-authored components, but doing it for every one of the
      many individual harvested DLL/data file components isn't practical
      and isn't needed - util:RemoveFolderEx already guarantees complete
      cleanup regardless of per-file component bookkeeping.

  IMPORTANT: UpgradeCode below must NEVER change across future versions.
  It is what lets Windows Installer recognize a new .msi as an upgrade
  of this same product instead of a separate, side-by-side install.
  Product Id is intentionally "*" (auto-generated per build) — that is
  standard WiX practice when relying on UpgradeCode + MajorUpgrade for
  upgrade detection.

  Version is passed in at build time via "candle -dProductVersion=X.Y.Z"
  (see .github/workflows/release.yml), read directly from
  src/systemmonitor/__init__.py's __version__ - this is the single source
  of truth for the app version, so this file never needs manual updates
  and can never drift out of sync with the app again.

  Uninstall requires no extra setup here: any properly built MSI with a
  stable UpgradeCode/ProductCode and correctly declared components (as
  below) automatically appears in Windows Settings > Apps, where it can
  be uninstalled through the normal Windows Installer uninstall flow.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*"
           Name="System Monitor"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="System Monitor Team"
           UpgradeCode="412EAF73-0FE0-48F3-B305-4570AAAA7304">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             Description="System Monitor Installer"
             Manufacturer="System Monitor Team" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="icon.ico" SourceFile="src\systemmonitor\assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="icon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/stiandammen/SystemMonitor" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/stiandammen/SystemMonitor" />

    <!-- Lets the WixUI_InstallDir wizard's directory-chooser page edit INSTALLFOLDER -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!--
      Disables Windows Installer's rollback + checkpointing (1+2) and full
      file-cost calculation (4) = 7. Without this, MSI creates a hidden
      "Config.Msi" staging folder at the ROOT of whichever drive the
      install target lives on (e.g. "E:\Config.Msi\") to hold rollback
      data, and tries to set NTFS security descriptors on the files in it.
      On machines where that drive root's ACLs don't grant the (non-admin,
      per-user-scope) current user permission to do that, this fails with
      the well-documented Windows Installer error "Could not set file
      security for file '...\Config.Msi\....rbf'. Error: 5." - a known
      issue independent of anything authored in this file (see e.g.
      Microsoft/IBM support articles and the PowerToys project hitting the
      identical error). MSIFASTINSTALL=7 stops MSI from ever creating or
      touching Config.Msi in the first place, which avoids the failure
      entirely regardless of that drive's ACL configuration. The
      trade-off (no automatic rollback if the install is interrupted) is
      an acceptable cost for actually completing a real install reliably.

      In practice this error has been confirmed NON-FATAL when it does
      still occur (observed specifically during MAJOR UPGRADE installs,
      not fresh installs - the old product's uninstall phase appears to
      touch Config.Msi through a path MSIFASTINSTALL alone doesn't fully
      suppress): clicking through it lets Windows Installer continue and
      finish the real file installation correctly regardless. DISABLEROLLBACK
      below is a second, more direct property aimed at the same mechanism,
      to reduce how often this warning appears further - but even if it
      still shows up occasionally on machines with unusual drive-root
      ACLs, it does not block the install from completing.
    -->
    <Property Id="MSIFASTINSTALL" Value="7" />
    <Property Id="DISABLEROLLBACK" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="System Monitor" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="System Monitor" />
      </Directory>
      <!-- Standard WiX-recognized folder id, resolves to the current user's Desktop -->
      <Directory Id="DesktopFolder" />
    </Directory>

    <!--
      Per-user (HKCU-scoped) components require a registry KeyPath rather
      than a file KeyPath (ICE38). util:RemoveFolderEx recursively deletes
      INSTALLFOLDER and everything under it (including the _internal\ tree
      heat.exe harvests into HarvestedFiles.wxs) on uninstall, so individual
      RemoveFolder/ICE64 bookkeeping for every harvested subfolder is not
      needed - see the top-of-file comment for the full explanation.
    -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="13CCD789-918A-4511-A6D4-CE033AFCC1DF">
        <File Id="SystemMonitorEXE"
              Source="dist\SystemMonitor\SystemMonitor.exe" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
        <util:RemoveFolderEx On="uninstall" Property="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                        Key="Software\SystemMonitor"
                        Name="InstallPath"
                        Type="string"
                        Value="[INSTALLFOLDER]SystemMonitor.exe"
                        KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="9F030125-56EA-4A56-848A-8B344A33C9D4">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="System Monitor"
                  Description="Real-time system performance monitoring"
                  Target="[INSTALLFOLDER]SystemMonitor.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="icon.ico" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                        Key="Software\SystemMonitor"
                        Name="Installed"
                        Type="integer"
                        Value="1"
                        KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="4F10BD16-ABC2-4A81-A3C1-51B83DBD19EC">
        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="System Monitor"
                  Description="Real-time system performance monitoring"
                  Target="[INSTALLFOLDER]SystemMonitor.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="icon.ico" />
        <RegistryValue Root="HKCU"
                        Key="Software\SystemMonitor"
                        Name="DesktopShortcutInstalled"
                        Type="integer"
                        Value="1"
                        KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!--
      Everything installs together as one feature - no optional feature tree
      with WixUI_InstallDir. HarvestedFiles is the ComponentGroup that
      heat.exe generates at build time from dist\SystemMonitor\ (see
      .github/workflows/release.yml) - it is defined in HarvestedFiles.wxs,
      not in this file, and is only resolved when candle compiles both
      files together.
    -->
    <Feature Id="ProductFeature" Title="System Monitor" Level="1" Absent="disallow" AllowAdvertise="no">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentGroupRef Id="HarvestedFiles" />
    </Feature>

    <!--
      "Launch System Monitor" checkbox on the finish page - WixShellExec
      comes from WixUtilExtension (see -ext WixUtilExtension in
      release.yml). Only fires on a fresh install/upgrade, not on repair.
      This mechanism is shared across all WixUI_* dialog sets, not specific
      to Mondo, so it stays as-is with the simplified WixUI_InstallDir.
    -->
    <Property Id="WixShellExecTarget" Value="[#SystemMonitorEXE]" />
    <CustomAction Id="LaunchApplication" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch System Monitor" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
    </UI>

    <!--
      Uninstall cleanup, redesigned as ONE combined step after two
      real-world test failures with a two-action version (kill process,
      then separately force-delete the folder):

      1. First failure (non-C: drive): repeated "Could not set file
         security for Config.Msi" dialogs during uninstall interrupted
         the transaction, leaving files behind despite MSIFASTINSTALL/
         DISABLEROLLBACK.
      2. Second failure (plain C: drive, no Config.Msi issue at all):
         SystemMonitor.exe was STILL left behind - almost certainly
         because it was still running (minimized to tray via the
         single-instance mutex) and Windows can't delete a loaded EXE,
         so it silently defers deletion to next reboot instead of erroring.

      A separate "kill, then immediately rmdir" attempt is itself a known
      failure mode: taskkill returns before Windows has actually finished
      releasing the terminated process's file handles, so an rmdir that
      runs immediately after can still hit "file in use". This version
      kills the process, waits ~2 seconds (via "ping -n 3 127.0.0.1",
      the traditional batch-script delay trick - "timeout" was avoided
      because it requires an interactive console and can fail silently
      when run from a non-console context like a deferred MSI action),
      and only then force-deletes the folder - all as ONE custom action,
      so there is no scheduling gap between separate actions to worry about.

      "REMOVE=ALL AND NOT UPGRADINGPRODUCTCODE" (plus Installed, for
      extra defensiveness per WiX community convention) is the standard
      condition for "this is a genuine, standalone uninstall" - it must
      NOT fire during a MajorUpgrade's internal removal of the OLD
      product, which would otherwise delete the NEW version's
      just-installed files immediately after an update.

      Return="ignore" so this can never itself cause the uninstall to
      fail or roll back, no matter what happens.

      Deferred custom actions cannot read arbitrary properties directly
      (a WiX/MSI restriction), so the resolved INSTALLFOLDER path is
      captured into CustomActionData by an immediate action first, then
      read back via [CustomActionData] in the deferred one.
    -->
    <CustomAction Id="SetUninstallCleanup" Property="UninstallCleanup" Value="[INSTALLFOLDER]" />
    <CustomAction Id="UninstallCleanup"
                  ExeCommand="cmd.exe /c taskkill /f /im SystemMonitor.exe >nul 2>&amp;1 &amp; ping -n 3 127.0.0.1 >nul &amp; rmdir /s /q &quot;[CustomActionData]&quot;"
                  Directory="TARGETDIR"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="yes" />

    <InstallExecuteSequence>
      <Custom Action="SetUninstallCleanup" Before="UninstallCleanup">Installed AND REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="UninstallCleanup" After="RemoveFiles">Installed AND REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>

    <!-- Wizard: welcome/license -> choose install directory -> install -> finish -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <UIRef Id="WixUI_InstallDir" />
    <UIRef Id="WixUI_ErrorProgressText" />

  </Product>
</Wix>
