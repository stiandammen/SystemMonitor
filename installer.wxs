<?xml version="1.0" encoding="UTF-8"?>
<!--
  System Monitor - WiX v3 installer definition.

  Installs per-user (no admin rights required). Default location is
  %LocalAppData%\Programs\System Monitor, matching the location already
  used by src/systemmonitor/utils/setup_installer.py - but the wizard
  below (WixUI_Mondo) lets the user change the install folder, and lets
  them opt in/out of the Start Menu and Desktop shortcuts individually.

  IMPORTANT: UpgradeCode below must NEVER change across future versions.
  It is what lets Windows Installer recognize a new .msi as an upgrade
  of this same product instead of a separate, side-by-side install.
  Product Id is intentionally "*" (auto-generated per build) — that is
  standard WiX practice when relying on UpgradeCode + MajorUpgrade for
  upgrade detection.

  Version is passed in at build time via "candle -dProductVersion=X.Y.Z"
  (see .github/workflows/release.yml), read directly from
  src/systemmonitor/__init__.py's __version__ - this is the single source
  of truth for the app version, so this file never needs manual updates
  and can never drift out of sync with the app again.

  Uninstall requires no extra setup here: any properly built MSI with a
  stable UpgradeCode/ProductCode and correctly declared components (as
  below) automatically appears in Windows Settings > Apps, where it can
  be uninstalled through the normal Windows Installer uninstall flow.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="System Monitor"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="System Monitor Team"
           UpgradeCode="412EAF73-0FE0-48F3-B305-4570AAAA7304">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             Description="System Monitor Installer"
             Manufacturer="System Monitor Team" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="icon.ico" SourceFile="src\systemmonitor\assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="icon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/stiandammen/SystemMonitor" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/stiandammen/SystemMonitor" />

    <!-- Lets the WixUI_Mondo wizard's directory-chooser page edit INSTALLFOLDER -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="System Monitor" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="System Monitor" />
      </Directory>
      <!-- Standard WiX-recognized folder id, resolves to the current user's Desktop -->
      <Directory Id="DesktopFolder" />
    </Directory>

    <!--
      Per-user (HKCU-scoped) components require a registry KeyPath rather
      than a file KeyPath (ICE38), and every custom directory under the
      user profile that this MSI creates must have a matching RemoveFolder
      entry so uninstall cleans it up (ICE64). RemoveFolder only deletes a
      directory if it ends up empty, so removing "Programs" here is safe
      even if other per-user apps also use %LocalAppData%\Programs.
    -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="13CCD789-918A-4511-A6D4-CE033AFCC1DF">
        <File Id="SystemMonitorEXE"
              Source="dist\SystemMonitor.exe" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                        Key="Software\SystemMonitor"
                        Name="InstallPath"
                        Type="string"
                        Value="[INSTALLFOLDER]SystemMonitor.exe"
                        KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="9F030125-56EA-4A56-848A-8B344A33C9D4">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="System Monitor"
                  Description="Real-time system performance monitoring"
                  Target="[INSTALLFOLDER]SystemMonitor.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="icon.ico" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                        Key="Software\SystemMonitor"
                        Name="Installed"
                        Type="integer"
                        Value="1"
                        KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="4F10BD16-ABC2-4A81-A3C1-51B83DBD19EC">
        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="System Monitor"
                  Description="Real-time system performance monitoring"
                  Target="[INSTALLFOLDER]SystemMonitor.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="icon.ico" />
        <RegistryValue Root="HKCU"
                        Key="Software\SystemMonitor"
                        Name="DesktopShortcutInstalled"
                        Type="integer"
                        Value="1"
                        KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!--
      Top-level feature (the app itself) is always installed - Absent="disallow"
      prevents it from being unchecked in the feature tree. The two shortcut
      features are independent and optional, so the user can turn either or
      both off during install.
    -->
    <Feature Id="ProductFeature" Title="System Monitor" Level="1" Absent="disallow" AllowAdvertise="no">
      <ComponentRef Id="MainExecutable" />
      <Feature Id="StartMenuShortcutFeature" Title="Start Menu Shortcut" Description="Adds a shortcut to the Start Menu." Level="1">
        <ComponentRef Id="ApplicationShortcut" />
      </Feature>
      <Feature Id="DesktopShortcutFeature" Title="Desktop Shortcut" Description="Adds a shortcut to the Desktop." Level="1">
        <ComponentRef Id="DesktopShortcut" />
      </Feature>
    </Feature>

    <!-- Full wizard: welcome/license -> feature selection (shortcuts on/off) -> install directory -> install -> finish -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <UIRef Id="WixUI_Mondo" />
    <UIRef Id="WixUI_ErrorProgressText" />

  </Product>
</Wix>
